# ---- Database ----
DATABASE_URL=jdbc:postgresql://localhost:5432/codeassistant
DATABASE_USERNAME=codeassistant
DATABASE_PASSWORD=codeassistant

# ---- GitHub OAuth2 ----
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- AI provider ----
# "ollama" (default, local/free) or "huggingface"
AI_PROVIDER=ollama
LLM_MODEL=llama3.1
EMBEDDING_MODEL=nomic-embed-text
# Must match the embedding model's actual output dimension. nomic-embed-text = 768.
EMBEDDING_DIMENSION=768

# Only used when AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434

# Only used when AI_PROVIDER=huggingface
HUGGINGFACE_API_KEY=

# ---- Frontend / CORS ----
FRONTEND_URL=http://localhost:3000
